{% from "components/section-heading.njk" import sectionHeading %}
{% from "components/cards.njk" import featureCard %}
{% from "components/icon.njk" import icon %}
{%- set s = home2.platform -%}
{%- set d = s.diagram -%}
<section class="platform theme-dark" id="{{ s.id }}">
  <div class="container">
    {{ sectionHeading({ eyebrow: s.eyebrow, title: s.title, body: s.body, tone: "dark" }) }}

    <figure class="platform-diagram" data-reveal aria-label="Diagram: physical hardware connects over wireless to Veranda's cloud software and partner systems">
      <div class="platform-diagram__side platform-diagram__side--physical">
        <p class="platform-diagram__label">{{ d.physical.label }}</p>
        {#- Layers nest inside one another: the enclosure wears the lock, which houses the boards and sensors. #}
        {%- for layer in d.physical.layers %}
        <div class="platform-diagram__nest platform-diagram__nest--{{ loop.index }}">
          <div class="platform-diagram__item">
            <span class="platform-diagram__icon">{{ icon(layer.icon, 18) }}</span>
            <span><strong>{{ layer.title }}</strong><small>{{ layer.caption }}</small></span>
          </div>
        {%- endfor %}
        {%- for layer in d.physical.layers %}
        </div>
        {%- endfor %}
      </div>

      <div class="platform-diagram__link" aria-hidden="true">
        <span class="platform-diagram__wire"><i></i><i></i><i></i></span>
        <div class="platform-diagram__chip">
          {{ icon(d.link.icon, 20) }}
          <strong>{{ d.link.title }}</strong>
          <small>{{ d.link.caption }}</small>
        </div>
        <span class="platform-diagram__wire platform-diagram__wire--reverse"><i></i><i></i><i></i></span>
      </div>

      <div class="platform-diagram__side platform-diagram__side--digital">
        <p class="platform-diagram__label">{{ d.digital.label }}</p>
        <ul class="platform-diagram__list">
          {%- for layer in d.digital.layers %}
          <li class="platform-diagram__item">
            <span class="platform-diagram__icon">{{ icon(layer.icon, 18) }}</span>
            <span><strong>{{ layer.title }}</strong><small>{{ layer.caption }}</small></span>
          </li>
          {%- endfor %}
        </ul>
      </div>
    </figure>

    <div class="feature-grid platform__capabilities">
      {%- for feature in s.capabilities %}
      {{ featureCard(feature) }}
      {%- endfor %}
    </div>
  </div>
</section>
