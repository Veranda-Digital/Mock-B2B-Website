{% from "components/section-heading.njk" import sectionHeading, eyebrow %}
{% from "components/cards.njk" import applicationCard %}
{% from "components/accordion.njk" import accordionItem %}
{% from "components/icon.njk" import icon %}
{%- set s = home2.applications -%}
<section class="app-benefits" id="{{ s.id }}">
  <div class="container">
    {{ sectionHeading({ eyebrow: s.eyebrow, title: s.title, body: s.body, align: "start" }) }}

    <div class="app-benefits__group">
      <p class="app-benefits__group-label"><span>{{ s.lead.index }}</span>{{ s.lead.label }}: <strong>{{ s.lead.title }}</strong></p>
      <div class="app-benefits__grid">
        {%- for card in s.lead.cards %}
        {{ applicationCard(card) }}
        {%- endfor %}
      </div>
    </div>

    <div class="app-benefits__group">
      <p class="app-benefits__group-label"><span>{{ s.beyond.index }}</span>{{ s.beyond.label }}</p>
      <article class="beyond-card" data-reveal>
        <img class="beyond-card__art" src="{{ s.beyond.illustration }}" alt="" width="220" height="220" loading="lazy">
        <div class="beyond-card__text">
          <h3 class="beyond-card__title">{{ s.beyond.title }}</h3>
          <p class="beyond-card__body">{{ s.beyond.body }}</p>
        </div>
        <ul class="beyond-card__examples">
          {%- for ex in s.beyond.examples %}
          <li><span class="icon-tile icon-tile--xs">{{ icon(ex.icon, 16) }}</span>{{ ex.label }}</li>
          {%- endfor %}
        </ul>
      </article>
    </div>
  </div>

  <div class="app-benefits__outcomes">
    <div class="container benefits__inner">
      <div class="app-benefits__outcomes-intro">
        {{ eyebrow(s.outcomes.eyebrow) }}
        <h3>{{ s.outcomes.title }}</h3>
        <p class="text-small">{{ s.outcomes.note }}</p>
      </div>
      <div class="accordion" data-reveal>
        {%- for item in s.outcomes.items %}
        {{ accordionItem(item, "outcomes") }}
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
