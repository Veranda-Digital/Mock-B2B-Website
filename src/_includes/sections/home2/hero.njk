{% from "components/button.njk" import button %}
{% from "components/section-heading.njk" import eyebrow %}
{% from "components/icon.njk" import icon %}
{%- set hero = home2.hero -%}
<section class="hero" id="hero">
  <canvas class="hero__route" data-hero-route
    data-color="{{ hero.animation.color }}"
    data-stops="{{ hero.animation.stops }}"
    data-speed="{{ hero.animation.speed }}"
    data-inset="{{ hero.animation.routeInset }}"
    data-trail="{{ hero.animation.trailLength }}"
    data-trail-gap="{{ hero.animation.trailGap }}"
    data-dot="{{ hero.animation.dotSize }}"
    data-badge="{{ hero.animation.badgeSize }}"
    aria-hidden="true"></canvas>

  <div class="container hero__content">
    {{ eyebrow(hero.eyebrow, "green") }}
    <h1 class="hero__title" data-reveal>{{ hero.title }}</h1>
    <p class="hero__body" data-reveal>{{ hero.body }}</p>
    <div class="hero__actions" data-reveal>
      {%- for b in hero.buttons %}
      {{ button(b.label, b.href, b.variant) }}
      {%- endfor %}
    </div>
    {%- if hero.pillars %}
    <ul class="hero__pillars" data-reveal>
      {%- for p in hero.pillars %}
      <li class="hero__pillar">{{ icon(p.icon, 16) }}<span>{{ p.label }}</span></li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </div>
</section>
