{% from "components/button.njk" import button %}
{% from "components/section-heading.njk" import eyebrow %}
{% from "components/cards.njk" import capabilityCard %}
{%- set hero = home3.hero -%}
<section class="hero{% if hero.capabilities %} hero--capabilities{% endif %}{% if hero.videos %} hero--video{% endif %}" id="hero">
  {%- if hero.videos %}
  <div class="hero__media" data-hero-video aria-hidden="true">
    {%- for v in hero.videos %}
    <video class="hero__video{% if loop.first %} is-active{% endif %}" src="{{ v.src }}" poster="{{ v.poster }}" muted playsinline preload="{{ 'auto' if loop.first else 'none' }}"></video>
    {%- endfor %}
    <div class="hero__scrim"></div>
  </div>
  <ol class="hero__scenes" data-hero-scenes aria-hidden="true">
    {%- for v in hero.videos %}
    <li class="hero__scene{% if loop.first %} is-active{% endif %}"><span class="hero__scene-bar"></span>{{ v.label }}</li>
    {%- endfor %}
  </ol>
  {%- endif %}
  <div class="container hero__content">
    <div class="hero__stage">
      {{ eyebrow(hero.eyebrow, "light" if hero.videos else "green") }}
      <h1 class="hero__title" data-reveal>{{ hero.title }}{% if hero.titleAccent %} <span class="hero__title-accent">{{ hero.titleAccent | keepHyphenated | safe }}</span>{% endif %}</h1>
      {%- if hero.body %}
      <p class="hero__body" data-reveal>{{ hero.body }}</p>
      {%- endif %}
      <div class="hero__actions" data-reveal>
        {%- for b in hero.buttons %}
        {{ button(b.label, b.href, b.variant) }}
        {%- endfor %}
      </div>
    </div>

    {%- if hero.capabilities %}
    <div class="hero__capabilities">
      {%- for c in hero.capabilities %}
      {{ capabilityCard(c) }}
      {%- endfor %}
    </div>
    {%- endif %}
  </div>
</section>
