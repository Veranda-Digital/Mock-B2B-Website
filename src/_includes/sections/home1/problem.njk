{% from "components/section-heading.njk" import eyebrow %}
{% from "components/cards.njk" import statRow %}
{%- set s = home1.problem -%}
<section class="problem theme-dark" id="{{ s.id }}">
  <div class="problem__inner">
    <div class="problem__heading">
      {{ eyebrow(s.eyebrow) }}
      <p class="problem__statement">
        <span class="problem__lead">{{ s.lead }}</span>
        <span class="problem__reveal" data-word-reveal>{{ s.statement }}</span>
      </p>
    </div>

    <div class="problem__stats">
      {%- for stat in s.stats %}
      {{ statRow(stat) }}
      {%- endfor %}
      <p class="problem__citation">
        {{ s.citation.before }}<a href="{{ site.links.mckinseyReport }}" target="_blank" rel="noopener"><em>{{ s.citation.linkText }}</em></a>{{ s.citation.after }}
      </p>
    </div>
  </div>
</section>
