{% from "components/section-heading.njk" import eyebrow %}
{%- set s = home.modules -%}
<section class="modules theme-dark" id="{{ s.id }}" data-board-stack style="--steps: {{ s.steps | length }}">
  <div class="modules__sticky">
    <div class="container modules__inner">
      <div class="modules__text">
        {{ eyebrow(s.eyebrow) }}
        <div class="modules__steps">
          {%- for step in s.steps %}
          <div class="modules__step{% if loop.first %} is-active{% endif %}" data-step="{{ loop.index0 }}">
            <p class="modules__label">{{ step.label }}</p>
            <p class="modules__body">{{ step.body }}</p>
          </div>
          {%- endfor %}
        </div>
      </div>

      <div class="modules__boards" aria-hidden="true">
        {%- for step in s.steps | reverse %}
        <img class="modules__board{% if loop.last %} is-visible{% endif %}" data-board="{{ loop.length - loop.index }}" src="{{ s.image.src }}" alt="" width="{{ s.image.width }}" height="{{ s.image.height }}" loading="lazy">
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
