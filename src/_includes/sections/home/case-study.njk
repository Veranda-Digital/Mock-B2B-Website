{% from "components/section-heading.njk" import sectionHeading %}
{% from "components/badge.njk" import tag %}
{% from "components/button.njk" import button %}
{%- set s = home.caseStudy -%}
<section class="case-study theme-dark" id="{{ s.id }}">
  <div class="container">
    {{ sectionHeading({ eyebrow: s.eyebrow, title: s.title, body: s.body, tone: "dark" }) }}

    <figure class="case-study__product" data-reveal>
      <img src="{{ s.product.src }}" alt="{{ s.product.alt }}" width="{{ s.product.width }}" height="{{ s.product.height }}" loading="lazy">
    </figure>

    <div class="split-card" data-reveal>
      <div class="split-card__text">
        {{ tag(s.feature.tag, "pink", "sm") }}
        <h3 class="split-card__title">{{ s.feature.title }}</h3>
        <p class="split-card__body">{{ s.feature.body }}</p>
      </div>
      <div class="split-card__media">
        {%- for photo in s.feature.photos %}
        <img class="split-card__photo split-card__photo--{{ loop.index }}" src="{{ photo.src }}" alt="{{ photo.alt }}" width="{{ photo.width }}" height="{{ photo.height }}" loading="lazy">
        {%- endfor %}
      </div>
    </div>

    <div class="case-study__action" data-reveal>
      {{ button(s.button.label, s.button.href, "arrow") }}
    </div>
  </div>
</section>
