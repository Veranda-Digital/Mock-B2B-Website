{% from "components/section-heading.njk" import sectionHeading %}
{% from "components/icon.njk" import icon %}
{%- set s = home.platform -%}
{%- set d = s.diagram -%}
<section class="platform theme-dark" id="{{ s.id }}">
  <div class="container">
    {{ sectionHeading({ eyebrow: s.eyebrow, title: s.title, body: s.body, tone: "dark" }) }}

    <figure class="platform-diagram platform-diagram--stacked" data-reveal aria-label="Diagram: physical hardware connects over wireless to Veranda's cloud software and partner systems">
      {%- for name in ["physical", "digital"] %}
      {%- set side = d[name] %}
      <div class="platform-diagram__side platform-diagram__side--{{ name }}">
        <p class="platform-diagram__label">{{ side.label }}</p>
        <ul class="platform-diagram__list">
          {%- for layer in side.layers %}
          <li class="platform-diagram__item" style="--row: {{ loop.index + 1 }}">
            <span class="platform-diagram__icon">{{ icon(layer.icon, 18) }}</span>
            <span><strong>{{ layer.title }}</strong><small>{{ layer.caption }}</small></span>
          </li>
          {%- endfor %}
        </ul>
      </div>
      {%- if loop.first %}
      <div class="platform-diagram__link" aria-hidden="true">
        <span class="platform-diagram__wire"><i></i><i></i><i></i></span>
        <div class="platform-diagram__chip">
          {{ icon(d.link.icon, 20) }}
          <strong>{{ d.link.title }}</strong>
          <small>{{ d.link.caption }}</small>
        </div>
        <span class="platform-diagram__wire platform-diagram__wire--reverse"><i></i><i></i><i></i></span>
      </div>
      {%- endif %}
      {%- endfor %}
    </figure>
  </div>
</section>
