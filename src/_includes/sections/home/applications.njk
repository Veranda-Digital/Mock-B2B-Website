{% from "components/section-heading.njk" import sectionHeading %}
{% from "components/cards.njk" import useCaseCard %}
{%- set s = home.applications -%}
<section class="applications" id="{{ s.id }}">
  <div class="applications__intro">
    {{ sectionHeading({ eyebrow: s.eyebrow, title: s.title, body: s.body, align: "start" }) }}
  </div>
  <div class="applications__grid">
    {%- for card in s.cards %}
    {{ useCaseCard(card) }}
    {%- endfor %}
  </div>
</section>
