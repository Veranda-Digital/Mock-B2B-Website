{% from "components/section-heading.njk" import sectionHeading %}
{% from "components/badge.njk" import pillBadge %}
{% from "components/cards.njk" import featureCard %}
{% from "components/glow-media.njk" import glowMedia %}
{% from "components/icon.njk" import icon %}
{%- set s = home.software -%}
{%- set item = s.showcase -%}
<section class="software" id="{{ s.id }}">
  <div class="container">
    {{ sectionHeading({ eyebrow: s.eyebrow, title: s.title, body: s.body }) }}

    <div class="showcase showcase--reverse software__showcase">
      <div class="showcase__text" data-reveal>
        {{ pillBadge(item.badge.label, item.badge.icon) }}
        <h3 class="showcase__title">{{ item.title }}</h3>
        <p class="showcase__body">{{ item.body }}</p>
        <ul class="software__audiences">
          {%- for a in item.audiences %}
          <li>{{ a }}</li>
          {%- endfor %}
        </ul>
      </div>
      {{ glowMedia(item.image, "phone") }}
    </div>

    {%- set sdk = s.sdk %}
    {%- if sdk %}
    <div class="showcase software__showcase software__showcase--sdk">
      <div class="showcase__text" data-reveal>
        {{ pillBadge(sdk.badge.label, sdk.badge.icon) }}
        <h3 class="showcase__title">{{ sdk.title }}</h3>
        <p class="showcase__body">{{ sdk.body }}</p>
        <ul class="software__audiences">
          {%- for a in sdk.audiences %}
          <li>{{ a }}</li>
          {%- endfor %}
        </ul>
      </div>
      {{ glowMedia(sdk.image, "code") }}
    </div>
    {%- endif %}

    <div class="feature-grid software__grid">
      {%- for feature in s.responsibilities %}
      <article class="capability-card software__card" data-reveal>
        <span class="capability-card__head">
          <span class="icon-tile icon-tile--xs">{{ icon(feature.icon, 16) }}</span>
          <h5 class="capability-card__label">{{ feature.title }}</h5>
        </span>
        <p class="software__card-body">{{ feature.body }}</p>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
