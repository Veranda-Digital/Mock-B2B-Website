{% from "components/section-heading.njk" import sectionHeading %}
{% from "components/cards.njk" import metricCard %}
{%- set s = home.delivering -%}
{%- set m = s.impact -%}
<section class="delivering" id="{{ s.id }}">
  <div class="opportunity delivering__impact">
    <div class="container">
      {{ sectionHeading({ eyebrow: m.eyebrow, title: m.title, body: m.body }) }}

      <div class="opportunity__grid">
        <div class="opportunity__metrics">
          {%- for metric in m.metrics %}
          {{ metricCard(metric, m.veranda) }}
          {%- endfor %}
        </div>
        <figure class="opportunity__image" data-reveal>
          <img src="{{ m.image.src }}" alt="{{ m.image.alt }}" width="{{ m.image.width }}" height="{{ m.image.height }}" loading="lazy">
        </figure>
      </div>

      <p class="delivering__note">{{ m.note }}</p>
    </div>
  </div>
</section>
