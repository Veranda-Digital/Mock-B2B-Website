{% from "components/section-heading.njk" import sectionHeading, eyebrow %}
{% from "components/icon.njk" import icon %}
{%- set s = home.value -%}
<section class="value" id="{{ s.id }}">
  <div class="container">
    {{ sectionHeading({ eyebrow: s.eyebrow, title: s.title }) }}

    <div class="value__lanes">
      {%- for lane in s.lanes %}
      <article class="value-lane value-lane--{{ lane.key }}" data-reveal>
        <p class="value-lane__label">{{ icon(lane.icon, 16) }}<span>{{ lane.label }}</span></p>
        <h3 class="value-lane__title">{{ lane.title }}</h3>
        <p class="value-lane__body">{{ lane.body }}</p>

        <ol class="value-lane__proofs">
          {%- for p in lane.proofs %}
          <li class="proof">
            {%- if p.icon %}
            <div class="proof__lead">
              <span class="proof__icon">{{ icon(p.icon, 24) }}</span>
              <p class="proof__tag">{{ p.tag }}</p>
            </div>
            {%- else %}
            <div class="proof__lead">
              {%- if p.display %}
              <p class="proof__value proof__value--range">{{ p.display }}</p>
              {%- else %}
              <p class="proof__value" data-counter data-suffix="{{ p.suffix }}" data-target="{{ p.value }}">{{ p.value }}{{ p.suffix }}</p>
              {%- endif %}
              <p class="proof__label">{{ p.label }}</p>
            </div>
            {%- endif %}
            <div class="proof__text">
              <h4 class="proof__title">{{ p.title }}</h4>
              <p class="proof__body">{{ p.body }}</p>
            </div>
          </li>
          {%- endfor %}
        </ol>
      </article>
      {%- endfor %}
    </div>

    <p class="value__note">{{ s.note }} <span class="value__source">Source: <a href="{{ s.source.href }}" target="_blank" rel="noopener">{{ s.source.label }}</a>.</span></p>

    {# What it does: four small product previews, moved here from the what-who section. #}
    <div class="value__capabilities">
      {{ eyebrow(s.capabilitiesLabel, "coral") }}
      <ul class="capabilities">
        {%- for c in s.capabilities %}
        <li class="capability" data-reveal>
          <div class="capability__head">
            <span class="capability__icon">{{ icon(c.icon, 22) }}</span>
            <h5 class="capability__label">{{ c.label }}</h5>
          </div>
          <p class="capability__title">{{ c.title }}</p>
          <ul class="capability__preview" aria-hidden="true">
            {%- for row in c.preview %}
            <li class="capability__row capability__row--{{ row.tone }}"><span>{{ row.left }}</span><strong>{{ row.right }}</strong></li>
            {%- endfor %}
          </ul>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>
