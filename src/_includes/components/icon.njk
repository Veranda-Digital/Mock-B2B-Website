{% macro icon(name, size = 24, strokeWidth = 1.5, className = "") -%}
<svg class="icon icon--{{ name }}{% if className %} {{ className }}{% endif %}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ strokeWidth }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ paths[name] | safe }}</svg>
{%- endmacro %}
