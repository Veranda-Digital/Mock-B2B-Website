{# field: { name, label, type ("text"|"email"|"textarea"), placeholder, required, half, autocomplete } #}
{% macro formField(field) -%}
{%- set id = "field-" + field.name -%}
<div class="form-field{% if field.half %} form-field--half{% endif %}">
  <label class="form-field__label" for="{{ id }}">{{ field.label }}</label>
  {%- if field.type == "textarea" %}
  <textarea class="form-field__control" id="{{ id }}" name="{{ field.name }}" placeholder="{{ field.placeholder }}" rows="5"{% if field.required %} required{% endif %}></textarea>
  {%- else %}
  <input class="form-field__control" id="{{ id }}" name="{{ field.name }}" type="{{ field.type }}" placeholder="{{ field.placeholder }}"{% if field.autocomplete %} autocomplete="{{ field.autocomplete }}"{% endif %}{% if field.required %} required{% endif %}>
  {%- endif %}
</div>
{%- endmacro %}
