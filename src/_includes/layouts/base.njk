<!doctype html>
<html lang="{{ site.lang }}">
<head>
  {% include "partials/head.njk" %}
</head>
<body class="page page--{{ pageClass or 'default' }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}

  <main id="main">
