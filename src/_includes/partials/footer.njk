<footer class="site-footer">
  <div class="container site-footer__inner">
    <a class="site-footer__logo" href="/" aria-label="{{ site.name }} home">
      <img src="/assets/images/logo-light.svg" alt="{{ site.name }}" width="247" height="56" loading="lazy">
    </a>
    <nav class="site-footer__links" aria-label="Footer">
      {%- for item in navigation.primary %}
      <a href="{{ item.href }}">{{ item.label }}</a>
      {%- endfor %}
      <a href="{{ site.links.privacyPolicy }}" target="_blank" rel="noopener">Privacy Policy</a>
    </nav>
  </div>
  <div class="container">
    <p class="site-footer__legal">{{ "" | year }} {{ site.copyright }}</p>
  </div>
</footer>
